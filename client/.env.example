# Environment settings. Copy the lines you need into the file for your environment:
#
#   .env.development   used by `npm run dev`      (local development)
#   .env.production    used by `npm run build`    (production; on Vercel set the same names in Project Settings)
#   .env.local         this machine only, overrides BOTH of the above (keep it for personal tweaks, or empty)
#
# These files are git-ignored. Only .env.example is committed.

# Where the browser sends API calls, no trailing slash.
#   development: leave empty. The dev server forwards /api to API_PROXY_TARGET (needed so session cookies work on localhost).
#   production:  the real API URL (it must be same-site with the website for the session cookies to be sent).
VITE_API_BASE_URL=

# Value of the x-auth-token header the API requires. Sent from the browser, so treat it as a public app key, not a secret.
VITE_API_AUTH_TOKEN=

# The public website (no trailing slash): report and news links open there, as {site}/reports/{url} and {site}/news-and-articles/{url}.
VITE_WEBSITE_URL=

# Development only: the API server the dev server forwards /api (and uploaded files) to.
#   local API:  http://localhost:4000
#   remote API: https://api.claight.net/procurement_resource_api
API_PROXY_TARGET=http://localhost:4000
